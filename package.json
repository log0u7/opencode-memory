{
  "name": "@log0u7/opencode-memory",
  "version": "0.10.0",
  "description": "Working memory for OpenCode: shared SQLite store with hybrid search, shared across all sessions on a machine.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/log0u7/opencode-memory.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@opencode/plugin": "^2.0.26",
    "@opentui/core": ">=0.5.0",
    "@opentui/solid": ">=0.5.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-tui-dist.mjs",
    "build:check": "pnpm run build && pnpm pack --dry-run",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:dist": "pnpm run build && node scripts/smoke-dist.mjs",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test:coverage && pnpm run smoke:dist",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@biomejs/biome": "2.6.5",
    "babel-preset-solid": "^1.9.12",
    "@opencode-ai/plugin": "1.19.5",
    "@opencode/plugin": "2.2.5",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
